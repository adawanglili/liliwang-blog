---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = [...new Set(posts.map((post) => post.data.category))];

const categorySlug = (category: string) =>
	category
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/(^-|-$)/g, '');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<p class="eyebrow">LILI WANG</p>

				<h1>
					Notes on technology,<br />
					work, and life.
				</h1>

				<p class="intro">
					I write about AI, technology, career, China,
					travel, and the things I'm curious about.
				</p>
			</section>

			<section class="section">
				<div class="section-heading">
					<h2>Latest</h2>
					<span>{posts.length} posts</span>
				</div>

				<div class="post-list">
					{
						posts.map((post) => (
							<article class="post">
								<div class="post-meta">
									<span>
										{post.data.pubDate.toLocaleDateString('en-US', {
											year: 'numeric',
											month: 'short',
											day: 'numeric',
										})}
									</span>

									<span>·</span>

									<a
										href={`/category/${categorySlug(post.data.category)}/`}
									>
										{post.data.category}
									</a>
								</div>

								<h3>
									<a href={`/blog/${post.id}/`}>
										{post.data.title}
									</a>
								</h3>

								<p>{post.data.description}</p>

								<a class="read-more" href={`/blog/${post.id}/`}>
									Read article →
								</a>
							</article>
						))
					}
				</div>
			</section>

			<section class="section explore">
				<div class="section-heading">
					<h2>Explore</h2>
				</div>

				<div class="topics">
					{
						categories.map((category) => (
							<a href={`/category/${categorySlug(category)}/`}>
								<span>{category}</span>
								<span>→</span>
							</a>
						))
					}
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 900px;
		margin: 0 auto;
		padding: 100px 32px;
	}

	.hero {
		max-width: 720px;
		margin-bottom: 120px;
	}

	.eyebrow {
		margin-bottom: 22px;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	.hero h1 {
		margin: 0;
		font-size: clamp(3rem, 7vw, 5.2rem);
		line-height: 1.02;
		letter-spacing: -0.05em;
	}

	.intro {
		max-width: 620px;
		margin-top: 30px;
		font-size: 1.25rem;
		line-height: 1.7;
		color: rgb(var(--gray));
	}

	.section {
		margin-bottom: 110px;
	}

	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 32px;
		border-bottom: 1px solid #eee;
		padding-bottom: 14px;
	}

	.section-heading h2 {
		margin: 0;
		font-size: 1.35rem;
	}

	.section-heading span {
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}

	.post-list {
		display: flex;
		flex-direction: column;
	}

	.post {
		padding: 34px 0;
		border-bottom: 1px solid #eee;
	}

	.post:first-child {
		padding-top: 0;
	}

	.post-meta {
		display: flex;
		gap: 8px;
		margin-bottom: 12px;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}

	.post-meta a {
		color: inherit;
		text-decoration: none;
	}

	.post-meta a:hover {
		text-decoration: underline;
	}

	.post h3 {
		margin: 0 0 10px;
		font-size: 1.65rem;
		line-height: 1.3;
	}

	.post h3 a {
		color: inherit;
		text-decoration: none;
	}

	.post h3 a:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.post > p {
		max-width: 680px;
		margin: 0 0 18px;
		line-height: 1.7;
		color: rgb(var(--gray));
	}

	.read-more {
		font-size: 0.9rem;
		color: inherit;
		text-decoration: none;
	}

	.read-more:hover {
		text-decoration: underline;
	}

	.topics {
		display: grid;
		grid-template-columns: 1fr 1fr;
		border-top: 1px solid #eee;
	}

	.topics a {
		display: flex;
		justify-content: space-between;
		padding: 20px 4px;
		border-bottom: 1px solid #eee;
		color: inherit;
		text-decoration: none;
		font-size: 1.05rem;
	}

	.topics a:hover {
		opacity: 0.55;
	}

	@media (max-width: 600px) {
		main {
			padding: 60px 20px;
		}

		.hero {
			margin-bottom: 80px;
		}

		.hero h1 {
			font-size: 3rem;
		}

		.intro {
			font-size: 1.1rem;
		}

		.section {
			margin-bottom: 80px;
		}

		.topics {
			grid-template-columns: 1fr;
		}
	}
</style>