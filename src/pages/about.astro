---
import { Image } from 'astro:assets';
import avatar from '../assets/ada-avatar.jpg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About — ${SITE_TITLE}`}
			description="About Lili Wang"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="intro">
				<Image src={avatar} alt="Ada Wang Lili" width={140} height={140} class="portrait" />

				<p class="eyebrow">ABOUT</p>

				<p class="lead">
					<span class="name">Ada Wang Lili</span> is a Program and Product Management
					professional with 20+ years of experience across localization,
					technical program management, AI, content platforms, and globalization.
				</p>

				<p class="lead">
					She writes about AI, machine translation, localization technology,
					product management, and emerging technology.
				</p>
			</section>

			<section class="content">
				<h2>What I write about</h2>

				<div class="topics">
					<div>
						<h3>AI & Technology</h3>
						<p>
							Things I'm learning about AI, software,
							product development, and technology.
						</p>
					</div>

					<div>
						<h3>Career & Work</h3>
						<p>
							Thoughts on product, program management,
							career transitions, and working with technology.
						</p>
					</div>

					<div>
						<h3>China & Culture</h3>
						<p>
							Observations, stories, and reflections
							from Chinese culture and life.
						</p>
					</div>

					<div>
						<h3>Travel & Outdoors</h3>
						<p>
							Hiking, travel, places I've visited,
							and things I discover along the way.
						</p>
					</div>
				</div>
			</section>

			<section class="content">
				<h2>Elsewhere</h2>

				<div class="links">
					<a href="#" target="_blank">LinkedIn ↗</a>
					<a href="#" target="_blank">GitHub ↗</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 800px;
		margin: 0 auto;
		padding: 100px 32px;
	}

	.intro {
		max-width: 720px;
		margin-bottom: 110px;
	}

	.intro :global(.portrait) {
		display: block;
		width: 140px;
		height: 140px;
		border-radius: 50%;
		object-fit: cover;
		margin-bottom: 28px;
		box-shadow: var(--box-shadow);
	}

	.eyebrow {
		margin-bottom: 24px;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	.name {
		font-size: 2.6rem;
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.03em;
		color: rgb(var(--black));
	}

	.lead {
		max-width: 680px;
		margin-top: 30px;
		font-size: 1.3rem;
		line-height: 1.7;
		color: rgb(var(--gray));
	}

	.content {
		margin-bottom: 90px;
	}

	h2 {
		margin-bottom: 35px;
		font-size: 1.4rem;
		border-bottom: 1px solid var(--border);
		padding-bottom: 14px;
	}

	.topics {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 45px 60px;
	}

	h3 {
		margin-bottom: 8px;
		font-size: 1.15rem;
	}

	.topics p {
		margin: 0;
		line-height: 1.7;
		color: rgb(var(--gray));
	}

	.links {
		display: flex;
		gap: 30px;
	}

	.links a {
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid currentColor;
		padding-bottom: 3px;
	}

	.links a:hover {
		opacity: 0.55;
	}

	@media (max-width: 600px) {
		main {
			padding: 60px 20px;
		}

		.intro {
			margin-bottom: 80px;
		}

		.topics {
			grid-template-columns: 1fr;
			gap: 35px;
		}
	}
</style>