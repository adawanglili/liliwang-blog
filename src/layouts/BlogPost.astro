---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & { readingTime: number };

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	readingTime,
} = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />

		<style>
			main {
				width: 100%;
				margin: 0;
			}

			.article-header {
				max-width: 900px;
				margin: 0 auto;
				padding: 80px 24px 50px;
			}

			.category {
				display: inline-block;
				margin-bottom: 20px;
				font-size: 0.85rem;
				font-weight: 600;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}

			.title {
				margin: 0;
				font-size: clamp(2rem, 4vw, 3.2rem);
				line-height: 1.12;
				letter-spacing: -0.035em;
			}

			.description {
				max-width: none;
				margin: 24px 0 0;
				font-size: 1.1rem;
				line-height: 1.65;
				color: rgb(var(--gray));
			}

			.meta {
				display: flex;
				gap: 12px;
				align-items: center;
				margin-top: 28px;
				font-size: 0.9rem;
				color: rgb(var(--gray));
			}

			.dot {
				opacity: 0.4;
			}

			.hero-image {
				max-width: 900px;
				margin: 0 auto 50px;
				padding: 0 24px;
			}

			.hero-image img {
				display: block;
				width: 100%;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}

			.prose {
    			width: 900px;
    			max-width: calc(100% - 48px);
    			margin: 0 auto;
    			padding-bottom: 80px;
    			color: rgb(var(--gray-dark));
    			font-size: 1.08rem;
    			line-height: 1.8;
			}

			.prose :global(h2) {
				margin-top: 2.5em;
				margin-bottom: 0.7em;
				font-size: 1.8rem;
				line-height: 1.2;
				color: rgb(var(--black));
			}

			.prose :global(h3) {
				margin-top: 2em;
				color: rgb(var(--black));
			}

			.prose :global(p) {
				margin: 0 0 1.5em;
			}

			.prose :global(a) {
				color: inherit;
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 3px;
			}

			.prose :global(blockquote) {
				margin: 2em 0;
				padding: 0.5em 1.5em;
				border-left: 3px solid rgb(var(--gray));
				font-size: 1.15rem;
				font-style: italic;
				color: rgb(var(--gray));
			}

			.prose :global(blockquote p) {
    			margin: 0;
			}

			.prose :global(ul),
			.prose :global(ol) {
				margin-bottom: 1.5em;
				padding-left: 1.5em;
			}

			.prose :global(li) {
				margin-bottom: 0.5em;
			}

			.prose :global(code) {
				padding: 0.15em 0.35em;
				border-radius: 4px;
				background: rgba(var(--gray-light), 0.5);
				font-size: 0.9em;
			}

			.prose :global(pre) {
				overflow-x: auto;
				padding: 1.2em;
				border-radius: 8px;
			}

			.prose :global(img) {
				max-width: 100%;
				height: auto;
				border-radius: 8px;
				margin: 2em 0;
			}

			.comments {
				width: 900px;
				max-width: calc(100% - 48px);
				margin: 0 auto;
				padding-bottom: 20px;
			}

			.article-footer {
				max-width: 720px;
				margin: 0 auto;
				padding: 30px 24px 80px;
				border-top: 1px solid var(--border);
			}

			.back-link {
				color: inherit;
				text-decoration: none;
				font-size: 0.95rem;
			}

			.back-link:hover {
				text-decoration: underline;
			}

			.last-updated-on {
				margin-top: 6px;
				font-style: italic;
			}

			@media (max-width: 720px) {
				.article-header {
					padding: 50px 20px 35px;
				}

				.title {
					font-size: 2.5rem;
				}

				.description {
					font-size: 1.05rem;
				}

				.hero-image {
					padding: 0 16px;
				}

				.prose {
					max-width: calc(100% - 32px);
					font-size: 1rem;
				}

				.comments {
					max-width: calc(100% - 32px);
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<article>
				<header class="article-header">
					<a class="category" href={`/category/${category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`}>
						{category}
					</a>

					<h1 class="title">{title}</h1>

					<p class="description">{description}</p>

					<div class="meta">
						<span>By Ada Wang Lili</span>
						<span class="dot">·</span>
						<FormattedDate date={pubDate} />
						<span class="dot">·</span>
						<span>{readingTime} min read</span>

						{
							updatedDate && (
								<>
									<span class="dot">·</span>
									<span class="last-updated-on">
										Updated <FormattedDate date={updatedDate} />
									</span>
								</>
							)
						}
					</div>
				</header>

				{
					heroImage && (
						<div class="hero-image">
							<Image
								width={900}
								height={450}
								src={heroImage}
								alt=""
							/>
						</div>
					)
				}

				<div class="prose">
					<slot />
				</div>

				<section class="comments">
					<script
						src="https://giscus.app/client.js"
						data-repo="adawanglili/liliwang-blog"
						data-repo-id="R_kgDOULP6VA"
						data-category="General"
						data-category-id="DIC_kwDOULP6VM4DFL_R"
						data-mapping="pathname"
						data-strict="0"
						data-reactions-enabled="1"
						data-emit-metadata="0"
						data-input-position="bottom"
						data-theme="preferred_color_scheme"
						data-lang="en"
						crossorigin="anonymous"
						async
					></script>
				</section>

				<footer class="article-footer">
					<a
						class="back-link"
						href={`/category/${category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`}
					>
						← More from {category}
					</a>
				</footer>
			</article>
		</main>

		<Footer />
	</body>
</html>