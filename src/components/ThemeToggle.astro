---
// Light and dark mode switch. Shows a moon in light mode and a sun in dark mode.
---

<button class="theme-toggle" type="button" aria-label="Switch to dark mode" data-theme-toggle>
	<svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true">
		<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
	</svg>
	<svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true">
		<circle cx="12" cy="12" r="4" />
		<path
			d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4"
		/>
	</svg>
</button>

<style>
	.theme-toggle {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		/* Lift slightly so the icon lines up with the link text, which sits
		   above its box center because of the links' underline border. */
		margin: -4px 0 0;
		padding: 0;
		border: 1px solid transparent;
		border-radius: 50%;
		background: transparent;
		color: rgb(var(--black));
		cursor: pointer;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease;
	}

	@media (hover: hover) {
		.theme-toggle:hover {
			background: rgba(var(--gray-light), 0.8);
			border-color: var(--border);
		}
	}

	.theme-toggle:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.icon {
		grid-area: 1 / 1;
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition:
			opacity 0.2s ease,
			transform 0.3s ease;
	}

	.sun {
		opacity: 0;
		transform: rotate(-60deg) scale(0.6);
	}

	:global([data-theme='dark']) .moon {
		opacity: 0;
		transform: rotate(60deg) scale(0.6);
	}

	:global([data-theme='dark']) .sun {
		opacity: 1;
		transform: none;
	}

	@media (max-width: 720px) {
		.theme-toggle {
			width: 32px;
			height: 32px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-toggle,
		.icon {
			transition: none;
		}
	}
</style>

<script>
	const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

	if (button) {
		const sync = () => {
			const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
			button.setAttribute('aria-label', `Switch to ${next} mode`);
		};

		button.addEventListener('click', () => {
			const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
			(window as unknown as { setTheme: (theme: string) => void }).setTheme(next);
		});

		document.addEventListener('themechange', sync);
		sync();
	}
</script>
